// Pipeline publication policy; scientific modules retain reusable IO contracts.
process {
    withName: '.*:SCEPTRE_VALIDATE' {
        publishDir = [path: params.outdir, mode: 'copy', overwrite: false]
    }
    withName: '.*:PARAMETERS' {
        publishDir = [path: "${params.outdir}/parameters", mode: 'copy', overwrite: false]
    }
    withName: '.*:ASSIGNMENT' {
        publishDir = [path: "${params.outdir}/assignment", mode: 'copy', overwrite: false]
    }
    withName: '.*:QC' {
        publishDir = [path: "${params.outdir}/qc", mode: 'copy', overwrite: false]
    }
    withName: '.*:CALIBRATION:(SCEPTRE_STAGE|SCEPTRE_COLLECT)' {
        publishDir = [path: "${params.outdir}/calibration", mode: 'copy', overwrite: false]
    }
    withName: '.*:POWER:(SCEPTRE_STAGE|SCEPTRE_COLLECT)' {
        publishDir = [path: "${params.outdir}/power", mode: 'copy', overwrite: false]
    }
    withName: '.*:DISCOVERY:(SCEPTRE_STAGE|SCEPTRE_COLLECT)' {
        publishDir = [path: "${params.outdir}/discovery", mode: 'copy', overwrite: false]
    }
    withName: '.*:SCEPTRE_EXPORT' {
        publishDir = [path: params.outdir, mode: 'copy', overwrite: false]
    }
}
