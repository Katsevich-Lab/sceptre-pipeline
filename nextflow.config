manifest {
    name = 'Katsevich-Lab/sceptre-pipeline'
    homePage = 'https://github.com/Katsevich-Lab/sceptre-pipeline'
    author = 'Eugene Katsevich; Timothy Barry and SCEPTRE contributors'
    contributors = [[name: 'Eugene Katsevich', github: 'ekatsevi', contribution: ['maintainer']]]
    doi = ''
    diagram = 'docs/images/workflow.svg'
    description = 'Certified complete-family SCEPTRE scientific workflows'
    mainScript = 'main.nf'
    version = '2.0.0-dev'
    nextflowVersion = '>=25.10.4'
}
plugins { id 'nf-schema@2.7.3' }
validation.logging.unrecognisedParams = 'error'
params {
    help = false
    test_data = false
    modules_testdata_base_path = null
    pipelines_testdata_base_path = null
    input = null
    input_bundle = null
    analysis_config = null
    environment_lock = null
    backing_directory = "${projectDir}/resources/empty_backing"
    outdir = 'results'
    analyses = 'calibration,power,discovery'
    stop_after = 'analysis'
    checkpoint_stage = 'input'
    execution_mode = 'reference'
    n_work_units = 4
    array_size = 100
    worker_arrays = false
    seed = 271828
    container_image = null
    container_image_sha256 = null
}
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
profiles {
    docker {
        docker.enabled = true
        process.container = params.container_image
    }
    apptainer {
        apptainer.enabled = true
        apptainer.runOptions = '--containall --cleanenv'
        apptainer.autoMounts = true
        process.container = params.container_image
    }
    slurm { includeConfig 'conf/slurm.config' }
    test { includeConfig 'conf/test.config' }
    test_full { includeConfig 'conf/test_full.config' }
}
report.enabled = true
report.file = "${params.outdir}/pipeline_info/report.html"
trace.enabled = true
trace.file = "${params.outdir}/pipeline_info/trace.tsv"
timeline.enabled = true
timeline.file = "${params.outdir}/pipeline_info/timeline.html"
dag.enabled = true
dag.file = "${params.outdir}/pipeline_info/dag.html"

report.overwrite = true
trace.overwrite = true
timeline.overwrite = true
dag.overwrite = true
