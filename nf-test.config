config {
    testsDir "."
    ignore 'benchmark/evidence/**'
    ignore 'tests/evidence/**'
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    if (!System.getenv("NFT_WORKDIR") && System.getenv("SCEPTRE_NFTEST_WORKDIR")) {
        workDir System.getenv("SCEPTRE_NFTEST_WORKDIR")
    }
    configFile "tests/nextflow.config"
    profile 'test'
    requires('nf-test': '0.9.5')
}
